<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle"><solid android:color="#33496F"/><corners android:radius="14dp"/></shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#FF6F88" android:endColor="#FF4A68"/>
                    <corners android:radius="14dp"/>
                    <stroke android:width="3dp" android:color="#FFFFFF"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#FF4A68" android:endColor="#D92B50"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
