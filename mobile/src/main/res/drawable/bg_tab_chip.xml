<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <gradient android:angle="0" android:startColor="#2F8CF0" android:endColor="#1B5FC4"/>
                <corners android:radius="20dp"/>
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/wise_card"/>
                <corners android:radius="20dp"/>
                <stroke android:width="1dp" android:color="@color/wise_card_stroke"/>
            </shape>
        </inset>
    </item>
</selector>
