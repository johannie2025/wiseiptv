<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_app_gradient">

    <!-- Barre du haut (mode normal) -->
    <LinearLayout android:id="@+id/top_bar"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="6dp" android:paddingEnd="12dp">
        <ImageButton android:id="@+id/btn_back_top"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back" android:padding="10dp"
            android:contentDescription="Retour"
            android:background="?selectableItemBackgroundBorderless" android:tint="@color/white"/>
        <TextView android:id="@+id/tv_top_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Zone vidéo -->
    <FrameLayout android:id="@+id/video_container"
        android:layout_width="match_parent" android:layout_height="220dp"
        android:background="@android:color/black">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:use_controller="false" app:resize_mode="fit"/>

        <!-- Barre supérieure (plein écran) -->
        <LinearLayout
            android:id="@+id/osd_top"
            android:layout_width="match_parent" android:layout_height="72dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/bg_osd_bar_top"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:alpha="0" android:visibility="gone">
            <ImageButton android:id="@+id/btn_back"
                android:layout_width="44dp" android:layout_height="44dp"
                android:src="@drawable/ic_arrow_back" android:padding="10dp"
                android:contentDescription="Retour"
                android:background="?selectableItemBackgroundBorderless" android:tint="@color/white"/>
            <TextView android:id="@+id/tv_channel_name"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="@color/white"
                android:textSize="16sp" android:textStyle="bold"
                android:ellipsize="end" android:maxLines="1" android:paddingStart="8dp"/>
            <TextView android:id="@+id/tv_live_badge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EN DIRECT" android:textColor="@color/white"
                android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/bg_badge_live"
                android:paddingStart="8dp" android:paddingEnd="8dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:layout_marginEnd="8dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_quality"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Auto" android:textColor="@color/wise_blue_light"
                android:textSize="12sp" android:paddingEnd="4dp"/>
            <ImageButton android:id="@+id/btn_quality"
                android:layout_width="44dp" android:layout_height="44dp"
                android:src="@drawable/ic_tune" android:padding="10dp"
                android:contentDescription="Qualité"
                android:background="?selectableItemBackgroundBorderless" android:tint="@color/white"/>
            <ImageButton android:id="@+id/btn_fav"
                android:layout_width="44dp" android:layout_height="44dp"
                android:src="@drawable/ic_favorite_border" android:padding="10dp"
                android:contentDescription="Favori"
                android:background="?selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/progress_bar"
            android:layout_width="56dp" android:layout_height="56dp"
            android:layout_gravity="center" android:visibility="gone"/>

        <TextView android:id="@+id/tv_error"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFF8A9B" android:textSize="13sp" android:gravity="center"
            android:visibility="gone" android:background="@drawable/bg_osd_pill"
            android:padding="14dp" android:layout_margin="16dp"/>

        <!-- Zapping (plein écran) -->
        <LinearLayout
            android:id="@+id/osd_zap_controls"
            android:layout_width="wrap_content" android:layout_height="56dp"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal" android:gravity="center"
            android:layout_marginBottom="56dp" android:visibility="gone"
            android:background="@drawable/bg_osd_pill"
            android:paddingStart="14dp" android:paddingEnd="14dp">
            <ImageButton android:id="@+id/btn_previous"
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Chaîne précédente"
                android:background="?selectableItemBackgroundBorderless" android:tint="@color/white"/>
            <ImageButton android:id="@+id/btn_next"
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@android:drawable/ic_media_next"
                android:contentDescription="Chaîne suivante"
                android:background="?selectableItemBackgroundBorderless" android:tint="@color/white"/>
        </LinearLayout>

        <!-- Commandes : pause / volume / plein écran -->
        <LinearLayout android:id="@+id/osd_bottom"
            android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_gravity="bottom" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:background="@drawable/bg_osd_bar_bottom">
            <ImageButton android:id="@+id/btn_play_pause"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_pause" android:padding="9dp"
                android:contentDescription="Lecture / pause"
                android:background="?selectableItemBackgroundBorderless" android:tint="@color/white"/>
            <ImageButton android:id="@+id/btn_mute"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_volume" android:padding="9dp"
                android:contentDescription="Son"
                android:background="?selectableItemBackgroundBorderless" android:tint="@color/white"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <ImageButton android:id="@+id/btn_fullscreen"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_fullscreen" android:padding="9dp"
                android:contentDescription="Plein écran"
                android:background="?selectableItemBackgroundBorderless" android:tint="@color/white"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Infos de la chaîne (mode normal) -->
    <ScrollView android:id="@+id/info_section"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scrollbars="none" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView android:id="@+id/info_badge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EN DIRECT" android:textColor="@color/white"
                android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/bg_badge_live"
                android:paddingStart="8dp" android:paddingEnd="8dp"
                android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone"/>
            <TextView android:id="@+id/info_name"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/white"
                android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:id="@+id/info_group"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="13sp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="14dp">
                <LinearLayout android:id="@+id/act_fav" style="@style/Wise.Action">
                    <ImageView android:id="@+id/act_fav_icon" android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_favorite_border" android:contentDescription="@null"/>
                    <TextView android:id="@+id/act_fav_label" style="@style/Wise.ActionLabel" android:text="Favori"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/act_share" style="@style/Wise.Action">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_share" android:tint="@color/white" android:contentDescription="@null"/>
                    <TextView style="@style/Wise.ActionLabel" android:text="Partager"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/act_record" style="@style/Wise.Action">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_record" android:tint="@color/white" android:contentDescription="@null"/>
                    <TextView style="@style/Wise.ActionLabel" android:text="Enregistrer"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/act_info" style="@style/Wise.Action">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_info" android:tint="@color/white" android:contentDescription="@null"/>
                    <TextView style="@style/Wise.ActionLabel" android:text="Plus d'infos"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/similar_header"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="20dp" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Chaînes similaires" android:textColor="@color/white"
                    android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btn_similar_all"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Voir tout  ›" android:textColor="@color/wise_blue_light"
                    android:textSize="13sp" android:padding="6dp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_similar"
                android:layout_width="match_parent" android:layout_height="100dp"
                android:clipToPadding="false"/>

            <LinearLayout android:id="@+id/epg_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="20dp" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Programme TV" android:textColor="@color/white"
                        android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/btn_back_live"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Revenir au direct  ›" android:textColor="@color/wise_blue_light"
                        android:textSize="13sp" android:padding="6dp" android:visibility="gone"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/epg_list"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
                <TextView android:id="@+id/tv_epg_empty"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_card" android:padding="14dp"
                    android:text="Chargement du programme…"
                    android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
