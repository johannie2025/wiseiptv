<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WiseIPTV" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/wise_blue</item>
        <item name="colorPrimaryVariant">@color/wise_blue_dark</item>
        <item name="colorSecondary">@color/wise_red</item>
        <item name="android:colorBackground">@color/wise_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:statusBarColor">@color/wise_bg_top</item>
        <item name="android:navigationBarColor">@color/wise_bg_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.WiseIPTV.Dialog</item>
    </style>

    <style name="Theme.WiseIPTV.Splash" parent="Theme.WiseIPTV">
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="Theme.WiseIPTV.Fullscreen" parent="Theme.WiseIPTV">
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
    </style>

    <style name="Theme.WiseIPTV.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_card</item>
        <item name="android:colorAccent">@color/wise_blue_light</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Style racine Wise requis par les layouts mobiles -->
    <style name="Wise">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Wise.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="Wise.Label">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    
    <style name="Wise.Button" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Wise.Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/bg_action</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Wise.ActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
