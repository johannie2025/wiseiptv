<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_tv_card_focus" android:padding="12dp"
    android:layout_marginBottom="6dp"
    android:clickable="true" android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <TextView android:id="@+id/tv_epg_time"
        android:layout_width="52dp" android:layout_height="wrap_content"
        android:textColor="@color/wise_blue_light" android:textSize="13sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_epg_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="14sp"
            android:maxLines="2" android:ellipsize="end"/>
        <ProgressBar android:id="@+id/epg_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:layout_marginTop="6dp" android:max="100"
            android:progressDrawable="@drawable/progress_gradient"
            android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/tv_epg_now"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:text="EN COURS"
        android:background="@drawable/bg_badge_blue" android:textColor="@color/white"
        android:textSize="10sp" android:textStyle="bold"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone"/>
    <ImageView android:id="@+id/iv_epg_replay"
        android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginStart="8dp" android:src="@drawable/ic_replay"
        android:tint="@color/wise_blue_light" android:contentDescription="Replay"
        android:visibility="gone"/>
</LinearLayout>
