<?xml version="1.0" encoding="utf-8"?>
<!-- Accueil TV immersif (style Netflix / Prime Video) :
     aperçu vidéo plein écran en fond, menu en haut, infos + boutons du héros, rangées de chaînes par catégorie. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- 1. Aperçu plein écran (le lecteur d'aperçu devient le lecteur plein écran au clic sur Regarder) -->
    <FrameLayout android:id="@+id/preview_card"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:focusable="false" android:clickable="true">
        <androidx.media3.ui.PlayerView android:id="@+id/tv_preview_player"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:use_controller="false" app:resize_mode="zoom"
            app:shutter_background_color="@android:color/transparent"/>
        <ProgressBar android:id="@+id/preview_loading"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="center" android:visibility="gone"/>
    </FrameLayout>

    <!-- 2. Voiles de lisibilité -->
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_left" android:focusable="false"/>
    <View android:layout_width="match_parent" android:layout_height="260dp"
        android:layout_gravity="bottom" android:background="@drawable/bg_scrim_bottom" android:focusable="false"/>
    <View android:layout_width="match_parent" android:layout_height="120dp"
        android:layout_gravity="top" android:background="@drawable/bg_scrim_top" android:focusable="false"/>

    <!-- 3. Contenu : héros + rangées -->
    <LinearLayout android:id="@+id/panel_browse"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingTop="76dp"
        android:clipChildren="false" android:clipToPadding="false">

        <!-- Héros : infos de la chaîne sélectionnée + guide -->
        <LinearLayout android:id="@+id/right_col"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="bottom"
            android:paddingStart="52dp" android:paddingEnd="52dp" android:paddingBottom="14dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tv_preview_live"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="● EN DIRECT" android:textColor="@color/white"
                    android:background="@drawable/bg_badge_live" android:textSize="12sp"
                    android:textStyle="bold" android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone"/>
                <TextView android:id="@+id/tv_info_name"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/white"
                    android:textSize="38sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"
                    android:shadowColor="#CC000000" android:shadowRadius="8" android:shadowDx="0" android:shadowDy="2"/>
                <TextView android:id="@+id/tv_info_group"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:textColor="#D9FFFFFF" android:textSize="16sp"
                    android:maxLines="1" android:ellipsize="end"/>

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="16dp">
                    <TextView android:id="@+id/btn_watch"
                        android:layout_width="wrap_content" android:layout_height="48dp"
                        android:gravity="center" android:text="▶  Regarder"
                        android:textColor="#0A1A35" android:textSize="17sp" android:textStyle="bold"
                        android:paddingStart="28dp" android:paddingEnd="28dp"
                        android:background="@drawable/btn_hero_play" android:focusable="true" android:clickable="true"/>
                    <TextView android:id="@+id/btn_fav"
                        android:layout_width="wrap_content" android:layout_height="48dp"
                        android:layout_marginStart="10dp" android:gravity="center" android:text="♡  Favori"
                        android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"
                        android:paddingStart="20dp" android:paddingEnd="20dp"
                        android:background="@drawable/btn_hero_sec" android:focusable="true" android:clickable="true"/>
                    <TextView android:id="@+id/btn_rec"
                        android:layout_width="wrap_content" android:layout_height="48dp"
                        android:layout_marginStart="10dp" android:gravity="center" android:text="⏺  Enregistrer"
                        android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"
                        android:paddingStart="20dp" android:paddingEnd="20dp"
                        android:background="@drawable/btn_hero_sec" android:focusable="true" android:clickable="true"/>
                    <TextView android:id="@+id/btn_live"
                        android:layout_width="wrap_content" android:layout_height="48dp"
                        android:layout_marginStart="10dp" android:gravity="center" android:text="↩  Direct"
                        android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"
                        android:paddingStart="20dp" android:paddingEnd="20dp"
                        android:background="@drawable/btn_hero_sec" android:focusable="true" android:clickable="true"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Guide des programmes (EPG) + replay -->
            <LinearLayout android:layout_width="340dp" android:layout_height="170dp"
                android:layout_marginStart="24dp" android:orientation="vertical"
                android:background="@drawable/bg_osd_pill" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" android:paddingStart="4dp"
                    android:text="Programme TV · Replay" android:textColor="@color/white"
                    android:textSize="14sp" android:textStyle="bold"/>
                <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:scrollbars="none" android:clipToPadding="false">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout android:id="@+id/epg_list"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                        <TextView android:id="@+id/tv_epg_empty"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary" android:textSize="13sp"
                            android:padding="6dp"/>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

        <!-- Rangées de chaînes -->
        <TextView android:id="@+id/tv_list_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="52dp" android:paddingBottom="2dp"
            android:textColor="#B3FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:letterSpacing="0.12" android:textAllCaps="true"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_list"
            android:layout_width="match_parent" android:layout_height="236dp"
            android:clipToPadding="false" android:clipChildren="false"
            android:paddingBottom="8dp"/>
    </LinearLayout>

    <!-- 4. Pages : Compte / Paramètres / À propos (fond opaque sur tout l'écran, sous le menu) -->
    <ScrollView android:id="@+id/panel_page"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/bg_app_gradient"
        android:paddingTop="76dp" android:clipToPadding="true"
        android:scrollbars="none" android:visibility="gone">
        <LinearLayout android:id="@+id/page_content"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="28dp"/>
    </ScrollView>

    <!-- 5. Menu du haut -->
    <LinearLayout android:id="@+id/nav_rail"
        android:layout_width="match_parent" android:layout_height="76dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="40dp" android:paddingEnd="40dp" android:paddingTop="12dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp"
            android:src="@mipmap/ic_launcher" android:scaleType="fitCenter"
            android:contentDescription="Wise IPTV"/>
        <TextView android:id="@+id/rail_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="WISE IPTV"
            android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"
            android:letterSpacing="0.08"/>
        <LinearLayout android:id="@+id/nav_items"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="28dp" android:orientation="horizontal"
            android:gravity="center_vertical"/>
        <TextView android:id="@+id/tv_sub_pill"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green" android:textColor="@color/white"
            android:textSize="12sp" android:textStyle="bold"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone"/>
    </LinearLayout>

    <!-- 6. Statut -->
    <TextView android:id="@+id/tv_sync_status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="84dp" android:layout_marginEnd="40dp"
        android:background="@drawable/bg_osd_pill" android:textColor="@color/wise_blue_light"
        android:textSize="14sp" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone"/>
    <ProgressBar android:id="@+id/progress_bar"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="center" android:visibility="gone"/>
    <TextView android:id="@+id/tv_empty"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center"
        android:textColor="@color/text_secondary" android:textSize="18sp"
        android:visibility="gone"/>
</FrameLayout>
