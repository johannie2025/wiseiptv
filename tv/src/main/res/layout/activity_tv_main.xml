<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- Fond par défaut (aucun flux) : image du monde + logo Wise IPTV -->
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/bg_world" android:scaleType="centerCrop" android:contentDescription="@null"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#22050810"/>
    <ImageView android:layout_width="260dp" android:layout_height="260dp" android:layout_gravity="center"
        android:layout_marginStart="120dp" android:alpha="0.35"
        android:src="@drawable/logo_splash" android:scaleType="fitCenter" android:contentDescription="@null"/>

    <!-- Fond immersif : l'aperçu occupe tout l'écran (style Netflix / Prime Video) -->
        <FrameLayout android:id="@+id/preview_card"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#000000" android:clickable="true" android:focusable="false">
            <androidx.media3.ui.PlayerView android:id="@+id/tv_preview_player"
                android:layout_width="match_parent" android:layout_height="match_parent"
                app:use_controller="false" app:resize_mode="zoom"
                app:shutter_background_color="@android:color/transparent"/>
            <TextView android:id="@+id/tv_preview_live"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|end" android:layout_margin="24dp"
                android:text="EN DIRECT" android:textColor="@color/white"
                android:background="@drawable/bg_badge_live" android:textSize="11sp"
                android:textStyle="bold" android:paddingStart="8dp" android:paddingEnd="8dp"
                android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone"/>
            <ProgressBar android:id="@+id/preview_loading"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="center" android:visibility="gone"/>
        </FrameLayout>
    <View android:id="@+id/scrim_a" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_left"/>
    <View android:id="@+id/scrim_b" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_bottom"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- BARRE DU HAUT : logo · bonjour · recherche · menus · affichage · compte -->
        <LinearLayout android:id="@+id/top_bar"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="14dp" android:paddingEnd="18dp"
            android:background="@drawable/scrim_top">
            <ImageView android:layout_width="44dp" android:layout_height="44dp"
                android:src="@mipmap/ic_launcher" android:scaleType="fitCenter"
                android:contentDescription="Wise IPTV"/>
            <TextView android:id="@+id/home_greeting"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="Bonjour Wise 👋"
                android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"
                android:maxLines="1"/>
            <EditText android:id="@+id/top_search"
                android:layout_width="190dp" android:layout_height="40dp"
                android:layout_marginStart="14dp" android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search" android:drawablePadding="8dp"
                android:drawableTint="@color/text_secondary"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:hint="Rechercher…" android:textColorHint="#8FA6CC"
                android:textColor="@color/white" android:textSize="14sp"
                android:singleLine="true" android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
                android:inputType="text" android:focusable="true" android:focusableInTouchMode="true"/>
            <LinearLayout android:id="@+id/nav_items"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:orientation="horizontal"
                android:gravity="center_vertical"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <TextView android:id="@+id/home_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green" android:textColor="@color/white"
                android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                android:visibility="gone"/>
            <ImageView android:id="@+id/btn_view_grid"
                android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
                android:src="@drawable/ic_grid" android:tint="@color/white" android:contentDescription="Grille"
                android:background="@drawable/bg_tv_focus" android:focusable="true" android:clickable="true"/>
            <ImageView android:id="@+id/btn_view_list"
                android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_playlist" android:tint="@color/white" android:contentDescription="Liste"
                android:background="@drawable/bg_tv_focus" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/home_avatar"
                android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="10dp"
                android:gravity="center" android:text="W" android:textColor="@color/white"
                android:textStyle="bold" android:textSize="16sp" android:background="@drawable/bg_avatar"
                android:focusable="true" android:clickable="true"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">

            <!-- MENU LATÉRAL : liste des chaînes de la section -->
            <LinearLayout android:id="@+id/nav_rail"
                android:layout_width="250dp" android:layout_height="match_parent"
                android:orientation="vertical" android:background="@drawable/scrim_rail"
                android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tv_list_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
                    android:layout_marginBottom="6dp" android:paddingStart="4dp" android:maxLines="1" android:ellipsize="end"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_side"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:clipToPadding="false" android:paddingBottom="8dp"/>
            </LinearLayout>

            <!-- Contenu -->
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1">

                <!-- ACCUEIL : aperçu vedette + grille de chaînes + reprendre / les plus regardées -->
                <LinearLayout android:id="@+id/panel_home"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:visibility="gone"
                    android:paddingTop="6dp" android:paddingBottom="10dp"
                    android:paddingStart="10dp" android:paddingEnd="0dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:orientation="horizontal" android:paddingEnd="12dp">
                        <FrameLayout android:id="@+id/home_hero"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@drawable/bg_card" android:clipToOutline="true"
                            android:focusable="true" android:clickable="true" android:padding="2dp">
                            <ImageView android:id="@+id/home_default_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                                android:src="@drawable/bg_world" android:scaleType="centerCrop" android:contentDescription="@null"/>
                            <ImageView android:id="@+id/home_default_logo" android:layout_width="200dp" android:layout_height="200dp"
                                android:layout_gravity="center" android:src="@drawable/logo_splash" android:scaleType="fitCenter"
                                android:alpha="0.9" android:contentDescription="@null"/>
                            <androidx.media3.ui.PlayerView android:id="@+id/home_preview"
                                android:layout_width="match_parent" android:layout_height="match_parent"
                                app:use_controller="false" app:resize_mode="zoom" app:surface_type="texture_view"
                                app:shutter_background_color="@android:color/transparent" android:alpha="0"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="top|start" android:layout_margin="10dp"
                                android:text="EN DIRECT" android:textColor="@color/white"
                                android:background="@drawable/bg_badge_live" android:textSize="11sp" android:textStyle="bold"
                                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_gravity="bottom" android:orientation="vertical"
                                android:background="@drawable/scrim_bottom" android:padding="12dp" android:paddingTop="30dp">
                                <TextView android:id="@+id/home_title"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold"
                                    android:maxLines="1" android:ellipsize="end"/>
                                <TextView android:id="@+id/home_sub"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:textColor="@color/text_secondary" android:textSize="12sp"
                                    android:maxLines="1" android:ellipsize="end"/>
                                <ProgressBar android:id="@+id/home_progress" style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent" android:layout_height="4dp"
                                    android:layout_marginTop="6dp" android:max="100"
                                    android:progressDrawable="@drawable/progress_gradient" android:visibility="gone"/>
                            </LinearLayout>
                        </FrameLayout>
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_grid"
                            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="132dp"
                        android:orientation="horizontal" android:layout_marginTop="8dp">
                        <LinearLayout android:layout_width="270dp" android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Reprendre la lecture" android:textColor="@color/white"
                                android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                            <LinearLayout android:id="@+id/home_resume"
                                android:layout_width="match_parent" android:layout_height="76dp"
                                android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp"
                                android:background="@drawable/bg_tv_card_focus" android:focusable="true" android:clickable="true">
                                <ImageView android:id="@+id/home_resume_logo"
                                    android:layout_width="64dp" android:layout_height="52dp"
                                    android:scaleType="fitCenter" android:contentDescription="@null"/>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                                    <TextView android:id="@+id/home_resume_name"
                                        android:layout_width="match_parent" android:layout_height="wrap_content"
                                        android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"
                                        android:maxLines="1" android:ellipsize="end"/>
                                    <TextView android:id="@+id/home_resume_sub"
                                        android:layout_width="match_parent" android:layout_height="wrap_content"
                                        android:textColor="@color/text_secondary" android:textSize="11sp"
                                        android:maxLines="1" android:ellipsize="end"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="18dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Chaînes les plus regardées" android:textColor="@color/white"
                                android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                            <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_row"
                                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                                android:clipToPadding="false" android:paddingEnd="30dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Chaînes : liste à gauche, aperçu plein espace + boutons + guide à droite -->
                <LinearLayout android:id="@+id/panel_browse"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="6dp"
                    android:paddingStart="16dp" android:paddingEnd="0dp">

                    <!-- Bloc héros : infos de la chaîne sur l'aperçu plein écran -->
                    <LinearLayout android:id="@+id/right_col"
                        android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="bottom"
                        android:paddingEnd="40dp">
                        <TextView android:id="@+id/tv_info_group"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/wise_blue_light" android:textSize="14sp" android:textStyle="bold"
                            android:letterSpacing="0.15" android:maxLines="1" android:ellipsize="end"/>
                        <TextView android:id="@+id/tv_info_name"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:maxWidth="560dp" android:layout_marginTop="2dp"
                            android:textColor="@color/white" android:textSize="30sp"
                            android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
                            android:shadowColor="#AA000000" android:shadowRadius="8"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView android:id="@+id/btn_watch"
                                android:layout_width="wrap_content" android:layout_height="40dp"
                                android:gravity="center" android:text="▶  Regarder"
                                android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
                                android:paddingStart="24dp" android:paddingEnd="24dp"
                                android:background="@drawable/btn_tv" android:focusable="true" android:clickable="true"/>
                            <TextView android:id="@+id/btn_fav"
                                android:layout_width="wrap_content" android:layout_height="40dp"
                                android:layout_marginStart="10dp" android:gravity="center" android:text="♡ Favori"
                                android:textColor="@color/white" android:textSize="14sp"
                                android:paddingStart="18dp" android:paddingEnd="18dp"
                                android:background="@drawable/bg_tv_card_focus" android:focusable="true" android:clickable="true"/>
                            <TextView android:id="@+id/btn_rec"
                                android:layout_width="wrap_content" android:layout_height="40dp"
                                android:layout_marginStart="10dp" android:gravity="center" android:text="⏺ Enregistrer"
                                android:textColor="@color/white" android:textSize="14sp"
                                android:paddingStart="18dp" android:paddingEnd="18dp"
                                android:background="@drawable/bg_tv_card_focus" android:focusable="true" android:clickable="true"/>
                            <TextView android:id="@+id/btn_live"
                                android:layout_width="wrap_content" android:layout_height="40dp"
                                android:layout_marginStart="10dp" android:gravity="center" android:text="↩ Direct"
                                android:textColor="@color/white" android:textSize="14sp"
                                android:paddingStart="18dp" android:paddingEnd="18dp"
                                android:background="@drawable/bg_tv_card_focus" android:focusable="true" android:clickable="true"
                                android:visibility="gone"/>
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:layout_marginBottom="2dp"
                            android:text="Programme TV · Replay" android:textColor="@color/white"
                            android:textSize="15sp" android:textStyle="bold"/>
                        <ScrollView android:layout_width="620dp" android:layout_height="170dp"
                            android:scrollbars="none" android:clipToPadding="false">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <LinearLayout android:id="@+id/epg_list"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:orientation="vertical"/>
                                <TextView android:id="@+id/tv_epg_empty"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:textColor="@color/text_secondary" android:textSize="14sp"
                                    android:padding="8dp"/>
                            </LinearLayout>
                        </ScrollView>
                    </LinearLayout>

                    <!-- Grille de chaînes : navigation dans tous les sens -->
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_list" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
                </LinearLayout>

                <!-- Pages : Compte / Paramètres / À propos -->
                <ScrollView android:id="@+id/panel_page"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scrollbars="none" android:visibility="gone">
                    <LinearLayout android:id="@+id/page_content"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="28dp"/>
                </ScrollView>

                <TextView android:id="@+id/tv_sync_status"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="top|end" android:layout_margin="16dp"
                    android:background="@drawable/bg_osd_pill" android:textColor="@color/wise_blue_light"
                    android:textSize="14sp" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone"/>
                <ProgressBar android:id="@+id/progress_bar"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_gravity="center" android:visibility="gone"/>
                <TextView android:id="@+id/tv_empty"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start" android:layout_marginStart="60dp"
                    android:textColor="@color/text_secondary" android:textSize="16sp"
                    android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
