<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="72dp">

        <FrameLayout
            android:id="@+id/browse_fragment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.68" />

        <LinearLayout
            android:id="@+id/tv_preview_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.32"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#990A1530">

            <androidx.media3.ui.PlayerView
                android:id="@+id/tv_preview_player"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:focusable="false"
                app:use_controller="false"
                app:resize_mode="zoom"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <TextView
                android:id="@+id/tv_preview_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Sélectionnez une chaîne"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Aperçu de la sélection"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F00A1530"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp"
        android:focusable="false">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter"
            android:focusable="false"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tv_top_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wise IPTV"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sub_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="🔍"
            android:textSize="25sp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:background="@drawable/btn_action_selector"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/btn_add"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="➕"
            android:textSize="20sp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true"
            android:background="@drawable/btn_action_selector"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/btn_sync"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="🔄"
            android:textSize="20sp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true"
            android:background="@drawable/btn_action_selector"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/btn_recents"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="🕐"
            android:textSize="20sp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true"
            android:background="@drawable/btn_action_selector"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/btn_account"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Compte"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true"
            android:background="@drawable/btn_action_selector"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Réglages"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true"
            android:background="@drawable/btn_action_selector"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/btn_about"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="À propos"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true"
            android:background="@drawable/btn_action_selector"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/tv_sync_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wise_blue_light"
            android:textSize="12sp"
            android:layout_marginStart="12dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:indeterminateTint="@color/wise_red"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
