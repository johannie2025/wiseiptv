<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/wise_bg">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/bg_world" android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#66040814"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center"
        android:paddingBottom="90dp">
        <ImageView android:id="@+id/splash_logo"
            android:layout_width="230dp" android:layout_height="230dp"
            android:layout_marginBottom="12dp"
            android:src="@mipmap/ic_launcher" android:scaleType="fitCenter"
            android:contentDescription="Wise IPTV"/>
        <TextView android:id="@+id/splash_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Wise IPTV" android:textColor="@color/white"
            android:textSize="42sp" android:textStyle="bold"/>
        <TextView android:id="@+id/splash_tagline"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="La télévision du monde à portée de main"
            android:textColor="@color/text_secondary" android:textSize="20sp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/splash_footer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:gravity="center_horizontal" android:paddingBottom="30dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Powered by W DESIGN" android:textColor="@color/white"
            android:textSize="14sp" android:letterSpacing="0.12"/>
        <ProgressBar android:id="@+id/splash_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="320dp" android:layout_height="6dp"
            android:layout_marginTop="14dp" android:max="100" android:progress="0"
            android:progressDrawable="@drawable/progress_gradient"/>
        <TextView android:id="@+id/splash_version"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Wise IPTV"
            android:textColor="#5C7099" android:textSize="12sp"/>
    </LinearLayout>
</FrameLayout>
